  "description": "Thin callable HTTP server that wraps @llazyemail/generate-template.run. For online editors, preview, and zip-download flows.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./src/server.mjs",
  "scripts": {
