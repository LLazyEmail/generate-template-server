# Copy to .env and adjust. All values are optional.

PORT=8787
HOST=0.0.0.0

# Catalog
# CATALOG_PATH=./examples/playing-with-lit-style-catalog.mjs

# Auth (leave unset for open dev mode)
# API_KEY=changeme

# Rate limit (set MAX=0 to disable)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Safety
MAX_BODY_BYTES=1000000
CORS_ORIGIN=*

# Observability
ENABLE_METRICS=1
ENABLE_RECENT=1
RECENT_LIMIT=50
